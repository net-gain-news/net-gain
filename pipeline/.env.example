# Copy to .env for local testing, or set these as real environment variables
# via cPanel's "Setup Python App" tool on Canspace. Never commit actual values.

# Anthropic (Section 1/5 of SPEC.md) - reused from the existing single-show project
ANTHROPIC_API_KEY=

# WordPress REST API auth - an Application Password for a user with the
# ng_service role (see net-gain-studio/README.md)
WP_BASE_URL=https://netgain.news
WP_SERVICE_USERNAME=
WP_SERVICE_APP_PASSWORD=

# Captivate (Section 6.1 of SPEC.md) - shared account login across all shows,
# reused from the existing single-show project. Only the per-show Captivate
# show ID (set via the show's own admin screen) differs per show.
CAPTIVATE_USER_ID=
CAPTIVATE_API_TOKEN=
# Manual posting (captivate_mode.py): the shows whose episodes the operator posts in Captivate's dashboard instead of the pipeline
# creating them through the API. "all", or a comma-separated list of Captivate show ids / WordPress show ids. Leave empty (or delete
# the line) for the original automatic publishing; takes effect on the next cron pass, no deploy.
CAPTIVATE_MANUAL_SHOWS=
# Where the 192 kbps copy of each manually posted episode is written: a folder inside the website's wp-content/uploads, named captivate-handoff.
CAPTIVATE_HANDOFF_DIR=

# Kit (kit.com) - a v4 API key from Settings > Developer, used to create and send
# the daily and weekly email broadcasts. Account-wide, not per show.
KIT_API_KEY=

# Google Cloud / Vertex AI (Section 7 of SPEC.md) - a new, dedicated GCP
# project, not the old Drive-oriented one. GOOGLE_SERVICE_ACCOUNT_JSON holds
# the full service-account key JSON contents, not a file path - same
# convention as the prior single-show project's Google integration.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: failure-email alerting (Section 9). If unset, notify.py logs
# and no-ops instead of silently pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
