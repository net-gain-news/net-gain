# Copy to .env for local testing, or set these as real environment variables
# via cPanel's "Setup Python App" tool on Canspace. Never commit actual values.

# Anthropic (Section 1/5 of SPEC.md) - reused from the existing single-show project
ANTHROPIC_API_KEY=

# WordPress REST API auth - an Application Password for a user with the
# ng_service role (see net-gain-studio/README.md)
WP_BASE_URL=https://netgain.news
WP_SERVICE_USERNAME=
WP_SERVICE_APP_PASSWORD=

# Optional: failure-email alerting (Section 9). If unset, notify.py logs
# and no-ops instead of silently pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
